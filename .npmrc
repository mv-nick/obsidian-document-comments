; Never run dependency lifecycle scripts. The only two in the tree are esbuild's
; postinstall (unneeded: the platform binary arrives via the lockfile-pinned
; optional package, and the release builds reproduce byte-for-byte without it)
; and fsevents' optional native build.
ignore-scripts=true
; Needed because obsidian pins exact @codemirror/state and @codemirror/view peer
; versions, and eslint-plugin-obsidianmd pins an exact obsidian version, both
; older than what we install. Re-check on each major bump of those packages.
legacy-peer-deps=true
